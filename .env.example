PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

REDIS_HOST=localhost
REDIS_PORT=6379

MQTT_BROKER_URL=mqtt://localhost:1883

AI_ENGINE_URL=http://localhost:8000

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d

OTP_EXPIRES_IN_MINUTES=5
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# SMTP (optional in dev — OTP is also logged to server console)
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@shrimpmate.local

SEED_OPERATOR_EMAIL=operator@shrimpmate.local
SEED_OPERATOR_PASSWORD=replace-with-a-local-operator-password